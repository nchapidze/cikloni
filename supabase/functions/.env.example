# Edge Function secrets. Never commit real values and never put them in the Angular apps.
#
# Hosted project:  npx supabase secrets set RESEND_API_KEY=re_... EMAIL_FROM="..." ...
# Local serving:   copy this file to supabase/functions/.env (git-ignored) and fill it in.
#
# Without RESEND_API_KEY or EMAIL_FROM, orders and status changes still work; emails are
# skipped with a warning in the function logs.

# Resend API key (https://resend.com/api-keys), "Sending access" is enough.
RESEND_API_KEY=
# Sender on a domain verified in Resend.
EMAIL_FROM="Cikloni <orders@cikloni.ge>"
# Optional: where customers' replies to order emails go.
EMAIL_REPLY_TO=
# Optional: receives a notification for every new order.
ORDER_NOTIFICATION_EMAIL=
# Links in the emails (logo: SHOP_URL/email/logo.png). These are the defaults.
SHOP_URL=https://cikloni.ge
ADMIN_URL=https://admin.cikloni.ge
